# Release image — API + Admin SPA bundled into a single container.
# The Fastify API serves /api/* and proxies Socket.io, then falls back to
# serving the compiled admin SPA for all other routes.
#
# Build:  docker build -f Dockerfile.release -t nivaro:latest .
#         docker build -f Dockerfile.release --target runner-slim -t nivaro:slim .
# Run:    docker run -p 3055:3055 --env-file .env nivaro:latest
#
# Two runners (#2789): `runner` (the default, last stage) renders PDFs and
# videos itself; `runner-slim` has no Chromium or ffmpeg and hands that work
# to a full process over RENDER_URL. Both step down to uid 1000 under tini, with a
# HEALTHCHECK, and write only /app/uploads, /app/work and /tmp.

# ─── Stage 1: base ───────────────────────────────────────────────────────────
FROM node:22-alpine AS base
RUN corepack enable pnpm

# ─── Stage 1b: workspace manifests with the version fields blanked ──────────
# Every release bumps a `version` (the root package.json always, a package's
# own on its release), and those files are copied in ahead of both installs.
# So both install layers (the production one is ~600 MB) were rebuilt on
# every release and every deployment downloaded them again, although the
# dependencies had not changed. The installs read dependencies, never the
# version: they get trimmed copies (below), whose content changes only when a
# dependency does. The real files are copied in after the install.
FROM base AS manifests
WORKDIR /src
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY api/package.json ./api/
COPY admin/package.json ./admin/
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/extension-kit/package.json ./packages/extension-kit/
COPY packages/shared/package.json ./packages/shared/
COPY packages/react/package.json ./packages/react/
COPY packages/mcp/package.json ./packages/mcp/
# Only what the installs read is kept — dependency maps, pnpm settings, bins
# and lifecycle hooks; every other field (version, scripts, exports,
# sideEffects, files…) is dropped, so editing one of those no longer rebuilds
# the install layers (0.2.72: an added npm script + a sideEffects list
# missed 17 of 24 cached steps and re-exported the whole cache).
RUN node -e "const fs = require('fs'); \
  const KEEP = ['name', 'private', 'packageManager', 'workspaces', 'pnpm', 'dependencies', 'devDependencies', \
    'peerDependencies', 'peerDependenciesMeta', 'optionalDependencies', 'dependenciesMeta', 'bundleDependencies', \
    'bundledDependencies', 'bin', 'engines', 'os', 'cpu']; \
  const HOOKS = ['preinstall', 'install', 'postinstall', 'prepare']; \
  for (const f of ['package.json', 'api/package.json', 'admin/package.json', 'packages/sdk/package.json', \
    'packages/extension-kit/package.json', 'packages/shared/package.json', 'packages/react/package.json', \
    'packages/mcp/package.json']) { \
    const j = JSON.parse(fs.readFileSync(f, 'utf8')); const out = { version: '0.0.0' }; \
    for (const k of KEEP) if (j[k] !== undefined) out[k] = j[k]; \
    const hooks = Object.fromEntries(Object.entries(j.scripts || {}).filter(([k]) => HOOKS.includes(k))); \
    if (Object.keys(hooks).length) out.scripts = hooks; \
    fs.writeFileSync(f, JSON.stringify(out, null, 2) + '\\n') }"

# ─── Stage 2: install all deps ───────────────────────────────────────────────
FROM base AS deps
WORKDIR /app
COPY --from=manifests /src/ ./
RUN pnpm install --frozen-lockfile

# ─── Stage 3: build base — workspace + node_modules + the SDK ───────────────
FROM base AS build
WORKDIR /app
# admin's tsc+vite needs more heap than the default when building in
# memory-constrained VMs (local Docker Desktop OOM'd at ~2GB)
ENV NODE_OPTIONS=--max-old-space-size=4096
# git for cloud extension injection; bash for its script (alpine ships ash)
RUN apk add --no-cache git bash
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/api/node_modules ./api/node_modules
COPY --from=deps /app/admin/node_modules ./admin/node_modules
COPY --from=deps /app/packages/sdk/node_modules ./packages/sdk/node_modules
COPY --from=deps /app/packages/extension-kit/node_modules ./packages/extension-kit/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/packages/react/node_modules ./packages/react/node_modules
COPY --from=deps /app/packages/mcp/node_modules ./packages/mcp/node_modules
COPY . .
# Stale incremental state makes tsc SKIP declaration emit in a fresh tree —
# a checked-in tsbuildinfo once shipped shared/dist without its .d.ts files.
RUN rm -f packages/*/tsconfig.tsbuildinfo api/tsconfig.tsbuildinfo
# Every package below imports the SDK's dist, so it builds once, here.
RUN pnpm --filter @nivaro/sdk build

# ─── Stage 3a / 3b: API and admin build IN PARALLEL ─────────────────────────
# BuildKit runs independent stages concurrently. The API chain (kit, mcp, api)
# never imports shared/react/admin, and the admin chain never imports the API,
# so one wait replaces two: the release image build took ~210 s serially; the
# admin chain alone (~155 s) is now the critical path.
FROM build AS build-api
# The API imports its extension contract from the kit; a mounted extension
# resolves the same package at runtime.
RUN pnpm --filter @nivaro/extension-kit build
# The API hosts the MCP server (/api/mcp) from the same package the npm stdio server ships.
RUN pnpm --filter @nivaro/mcp build
# Inject cloud-only extensions before API build (fail-safe: exits 0 on any error).
# CLOUD_EXTENSIONS_REPO is a plain build ARG. The token is a BuildKit SECRET
# with id CLOUD_EXTENSIONS_TOKEN (`docker build --secret
# id=CLOUD_EXTENSIONS_TOKEN,env=CLOUD_EXTENSIONS_TOKEN`; Railway mounts a
# service variable of that name the same way): a secret never enters the
# build metadata, the layer cache or `docker history`. The CLOUD_EXTENSIONS_TOKEN
# build ARG still works as a fallback for builders that cannot pass secrets
# yet, and the script warns when it is used.
ARG CLOUD_EXTENSIONS_REPO=""
ARG CLOUD_EXTENSIONS_TOKEN=""
RUN --mount=type=secret,id=CLOUD_EXTENSIONS_TOKEN,required=false \
    CLOUD_EXTENSIONS_REPO="$CLOUD_EXTENSIONS_REPO" \
    CLOUD_EXTENSIONS_TOKEN_FILE=/run/secrets/CLOUD_EXTENSIONS_TOKEN \
    CLOUD_EXTENSIONS_TOKEN="$CLOUD_EXTENSIONS_TOKEN" \
    bash api/scripts/inject-cloud-extensions.sh
RUN pnpm --filter @nivaro/api build

FROM build AS build-admin
# Build order matters: shared type-imports @nivaro/sdk's dist, admin imports
# shared's dist — without sdk built first, inference collapses to implicit-any.
RUN pnpm --filter @nivaro/shared build
# admin imports @nivaro/react (Playground's live form preview)
RUN pnpm --filter @nivaro/react build
# `vite build` alone: the admin's `build` script is `tsc -b && vite build`, and
# the typecheck already gated the release (release-chain preflight) — the
# image build only bundles.
RUN pnpm --filter @nivaro/admin exec vite build && node scripts/precompress-dist.mjs admin/dist


# ─── Stage 4: production dependencies ───────────────────────────────────────
# Installed once and copied into BOTH runner variants (below), from the
# version-blanked manifests (see the manifests stage), so this layer survives
# a release that changed no dependency. Same musl base as the runners, so
# native prebuilds (sharp, tree-sitter) match. No browser download: the full
# image uses Alpine's chromium (the puppeteer-downloaded Chrome is
# glibc-linked and cannot run on musl at all) and the slim one has none.
FROM node:22-alpine AS prod-deps
RUN apk add --no-cache libc6-compat
RUN corepack enable pnpm
ENV PUPPETEER_SKIP_DOWNLOAD=true
WORKDIR /app
COPY --from=manifests /src/pnpm-workspace.yaml /src/pnpm-lock.yaml /src/package.json ./
COPY --from=manifests /src/api/package.json ./api/
COPY --from=manifests /src/packages/sdk/package.json ./packages/sdk/
COPY --from=manifests /src/packages/extension-kit/package.json ./packages/extension-kit/
COPY --from=manifests /src/packages/shared/package.json ./packages/shared/
COPY --from=manifests /src/packages/react/package.json ./packages/react/
COPY --from=manifests /src/packages/mcp/package.json ./packages/mcp/
RUN pnpm install --frozen-lockfile --prod --filter @nivaro/api...

# ─── Stage 5: the release's own files ───────────────────────────────────────
# Everything that changes with each release, gathered in one tree so each
# runner takes it as ONE layer on top of the dependency layer.
FROM scratch AS app-files
# The real manifests: the API reports its own version and the admin's
# @nivaro/react version from them (api/src/version.ts). They replace the
# version-blanked copies the install layer carries.
COPY package.json /app/
COPY api/package.json /app/api/
COPY packages/sdk/package.json /app/packages/sdk/
COPY packages/extension-kit/package.json /app/packages/extension-kit/
COPY packages/shared/package.json /app/packages/shared/
COPY packages/react/package.json /app/packages/react/
COPY packages/mcp/package.json /app/packages/mcp/
# Compiled API + SDK
COPY --from=build-api /app/api/dist /app/api/dist
COPY --from=build /app/packages/sdk/dist /app/packages/sdk/dist
COPY --from=build-api /app/packages/extension-kit/dist /app/packages/extension-kit/dist
COPY --from=build-api /app/packages/mcp/dist /app/packages/mcp/dist
# Cloud extensions (injected from private repo during build — dir may not exist in OSS builds)
COPY --from=build-api /app/api/cloud-extensions /app/api/cloud-extensions
# Admin SPA — Fastify serves this at /app/admin/dist (resolved from api/dist/server.js)
COPY --from=build-admin /app/admin/dist /app/admin/dist
# Mail templates
COPY api/templates /app/api/templates
# Teams app package icons (api/assets/teams, read by services/teams-bot/manifest.ts)
COPY api/assets /app/api/assets
# Release notes, generated from git tags at release time. Copied because the
# container has no git repository to read them from.
COPY changelog.json /app/changelog.json
# PID 1 setup (writable dirs, heap from the memory limit) and the HEALTHCHECK.
COPY deploy/image/docker-entrypoint.sh deploy/image/healthcheck.sh /app/

# ─── Stage 6: operating system layers ───────────────────────────────────────
# Upgrade Alpine packages to pick up security patches (busybox etc.). With
# the layer cache this step would never run again until node:22-alpine moves;
# APK_WEEK (the ISO week, passed by the Docker Hub workflow) reruns it — and
# the chromium layer above it — once a week. These layers sit UNDER the app
# layers, so a release that changed no OS package ships none of them again.
FROM node:22-alpine AS os-slim
ARG APK_WEEK=""
RUN echo "apk refresh ${APK_WEEK}" && apk upgrade --no-cache
# libc6-compat for sharp's (image processing) native binaries on Alpine; tini
# is PID 1 (#2788): it forwards SIGTERM to the API, whose drain then runs,
# and reaps the orphaned Chromium and ffmpeg children a crash leaves behind
# (node as PID 1 does neither: it ignores signals it has no handler for and
# never waits on orphans, which pile up as zombies). su-exec is the
# entrypoint's step-down from root to node (#2786), like postgres and redis.
RUN apk add --no-cache libc6-compat ca-certificates tini su-exec
RUN corepack enable pnpm

# The full image adds what renders: system chromium for puppeteer (PDFs,
# help-video cards and annotations, session-replay video), fonts, and ffmpeg
# (help-video probes, remuxes, conversions, renders). ~800 MB of the image.
FROM os-slim AS os-full
RUN apk add --no-cache chromium nss freetype harfbuzz ttf-freefont ffmpeg

# ─── Stage 7a: slim runner — `--target runner-slim`, nodeworks/nivaro:<v>-slim
# No Chromium, no ffmpeg (#2789). Everything that needs them goes to the
# render peer named in RENDER_URL (a full process with RENDER_TOKEN set, see
# api/src/services/render-peer.ts), or refuses with a 503 that says so. It
# never takes the help-video render queue (NIVARO_IMAGE_VARIANT=slim).
#
# The runtime block below is the same in both runners (a stage cannot be
# shared across two bases); change both.
FROM os-slim AS runner-slim
WORKDIR /app
COPY --from=prod-deps /app /app
COPY --from=app-files /app /app
# Runs as `node` (uid 1000, #2786). No USER: the entrypoint starts as root,
# hands /app/work (and an empty or top-level-only /app/uploads) to node and
# steps down with su-exec; it stays root, saying so in one line, when
# /app/uploads holds files node cannot write (a volume an older root image
# filled; NFS root_squash) or when the step-down is refused (cap_drop ALL),
# so an upgrade never breaks writes. A deployment's own `user:` wins.
# The ONLY paths it writes (#2790 — a read-only root filesystem works):
# /app/uploads (files; mount a volume), /app/work (TMPDIR = scratch,
# help-video work, heap snapshots, Chromium's profile; HOME = font and
# browser caches; a volume or tmpfs) and /tmp. Owned by node here, so a NEW
# named volume mounted on them copies that ownership (and `user: 1000:1000`
# works on it). /app/work is 1777 like /tmp: a tmpfs mounted there copies the
# MODE but is owned by root (swarm/compose 3.8 drop tmpfs.mode and uid), and
# uid 1000 must still create tmp/ and home/ in it.
RUN mkdir -p /app/uploads /app/work/tmp /app/work/home \
  && chown -R node:node /app/uploads /app/work \
  && chmod 1777 /app/work \
  && chmod 0755 /app/docker-entrypoint.sh /app/healthcheck.sh
# NODE_ENV=production: the image is a deployment, never a dev server. Unset,
# config.ts falls back to development (chaos gate open, dev-only routes and
# behaviour). A deployment that really wants another value still sets it.
ENV TMPDIR=/app/work/tmp \
    HOME=/app/work/home \
    NODE_ENV=production \
    NIVARO_IMAGE_VARIANT=slim
LABEL org.opencontainers.image.title="Nivaro (slim)" \
      org.opencontainers.image.source="https://github.com/nodeworks/nivaro"
EXPOSE 3055
# Liveness only (#2787): the process answers HTTP. start-period covers boot
# migrations (EFP measures them at up to ~2 minutes), during which failures
# do not count.
HEALTHCHECK --interval=30s --timeout=5s --start-period=150s --retries=3 CMD ["/app/healthcheck.sh"]
# tini, then the entrypoint, then the command — an overridden `command:`
# (`sh -c "...; exec node api/dist/index.js"`) still runs under both.
ENTRYPOINT ["/sbin/tini", "--", "/app/docker-entrypoint.sh"]
CMD ["node", "api/dist/index.js"]

# ─── Stage 7b: full runner — the DEFAULT target, nodeworks/nivaro:<v> ──────────
# What self-hosters and nivaro-cloud run: it renders locally. Kept LAST so a
# plain `docker build -f Dockerfile.release .` still builds it.
FROM os-full AS runner
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
WORKDIR /app
COPY --from=prod-deps /app /app
COPY --from=app-files /app /app
RUN mkdir -p /app/uploads /app/work/tmp /app/work/home \
  && chown -R node:node /app/uploads /app/work \
  && chmod 1777 /app/work \
  && chmod 0755 /app/docker-entrypoint.sh /app/healthcheck.sh
ENV TMPDIR=/app/work/tmp \
    HOME=/app/work/home \
    NODE_ENV=production \
    NIVARO_IMAGE_VARIANT=full
LABEL org.opencontainers.image.title="Nivaro" \
      org.opencontainers.image.source="https://github.com/nodeworks/nivaro"
EXPOSE 3055
HEALTHCHECK --interval=30s --timeout=5s --start-period=150s --retries=3 CMD ["/app/healthcheck.sh"]
ENTRYPOINT ["/sbin/tini", "--", "/app/docker-entrypoint.sh"]
CMD ["node", "api/dist/index.js"]
