{
  "name": "nivaro-cms",
  "private": true,
  "version": "0.3.24",
  "scripts": {
    "dev": "node scripts/dev-preflight.mjs",
    "dev:all": "concurrently --kill-others-on-fail -n redis,api,admin -c cyan,blue,green \"pnpm dev:redis\" \"wait-on tcp:6379 && pnpm dev:api\" \"pnpm --filter @nivaro/admin dev\"",
    "chaos:boot": "node scripts/chaos/boot-drills.mjs",
    "chaos:toxiproxy": "node scripts/chaos/toxiproxy-suite.mjs",
    "chaos:gallery": "node scripts/chaos/error-gallery.mjs",
    "chaos:deploy-load": "node scripts/chaos/deploy-under-load.mjs",
    "dev:check": "node scripts/dev-preflight.mjs --check",
    "dev:db": "node scripts/dev-against-db.mjs",
    "dev:api": "pnpm --filter @nivaro/api dev",
    "dev:admin": "pnpm --filter @nivaro/admin dev",
    "dev:mail": "docker run --rm --name nivaro-mailpit -p 127.0.0.1:1025:1025 -p 127.0.0.1:8025:8025 -v nivaro_mailpit_data:/data -e MP_DATABASE=/data/mailpit.db -e MP_SMTP_AUTH_ACCEPT_ANY=true -e MP_SMTP_AUTH_ALLOW_INSECURE=true axllent/mailpit:v1.31.6",
    "dev:redis": "docker run --rm -p 6379:6379 -v nivaro_redis_data:/data redis:7-alpine redis-server --appendonly yes",
    "dev:docker": "docker compose up --build",
    "dev:docker:down": "docker compose down",
    "kill:api": "node scripts/kill-api.mjs",
    "dev:www": "npx browser-sync start --server www --files 'www/**/*' --port 3057 --open --extensions html",
    "build": "pnpm --filter @nivaro/api build && pnpm --filter @nivaro/admin build",
    "build:shared": "pnpm --filter @nivaro/shared build && pnpm --filter @nivaro/react build",
    "build:react": "pnpm --filter @nivaro/react build",
    "pack:react": "pnpm build:shared && pnpm --filter @nivaro/sdk build && pnpm --filter @nivaro/sdk exec pnpm pack --pack-destination ~/Desktop/nivaro-packs && pnpm --filter @nivaro/react exec pnpm pack --pack-destination ~/Desktop/nivaro-packs",
    "release": "./api/node_modules/.bin/tsx scripts/sync-docs.ts && node scripts/release.mjs",
    "sdk:release": "./api/node_modules/.bin/tsx scripts/sync-docs.ts && node scripts/release-sdk.mjs",
    "react:release": "node scripts/release-react.mjs",
    "kit:release": "node scripts/release-kit.mjs",
    "mcp:release": "node scripts/release-mcp.mjs",
    "release:chain": "node scripts/release-chain.mjs",
    "www:release": "./api/node_modules/.bin/tsx scripts/sync-docs.ts && node scripts/release-www.mjs",
    "sync-docs": "./api/node_modules/.bin/tsx scripts/sync-docs.ts",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "docs:ai-index": "./api/node_modules/.bin/tsx scripts/build-docs-index.ts",
    "migrate": "pnpm --filter @nivaro/api migrate",
    "migrate:rollback": "pnpm --filter @nivaro/api migrate:rollback",
    "seed:directus": "pnpm --filter @nivaro/api seed:directus",
    "fix:roles": "pnpm --filter @nivaro/api fix:roles",
    "fix:collections": "pnpm --filter @nivaro/api fix:collections",
    "check": "biome check .",
    "lint:traps": "node scripts/lint-traps.mjs",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "fix:import-order": "biome check --linter-enabled=false --formatter-enabled=false --write .",
    "dead-code": "fallow dead-code",
    "dupes": "fallow dupes",
    "health": "fallow health",
    "test:api": "pnpm --filter @nivaro/api test",
    "test:admin": "pnpm --filter @nivaro/admin test",
    "test:unit": "pnpm --filter @nivaro/api test && pnpm --filter @nivaro/admin test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed --channel chrome",
    "test:e2e:cdp": "playwright test --config playwright.cdp.config.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.101.0",
    "@axe-core/playwright": "^4.10.0",
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.49.0",
    "concurrently": "^9.1.2",
    "fallow": "^2.88.3",
    "wait-on": "^9.0.10"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.4.0"
}
