# ─── Database ────────────────────────────────────────────────────────────────
# Database client: mssql (default) | pg | mysql2.
# pg / mysql2 drivers are optional — install the npm package when used.
# DB_CLIENT=mssql
DB_HOST=your-db-host.example.com
# Optional — defaults per client: mssql 1433, pg 5432, mysql2 3306
# DB_PORT=
DB_DATABASE=your_database
DB_USER=sa
DB_PASSWORD=your_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true
# Servers with an internal / corporate CA: trust that CA instead of turning TLS checks off
# (never set NODE_TLS_REJECT_UNAUTHORIZED=0 — it disables certificate checks for EVERY
# outbound call: identity provider, mail, partner APIs).
# NODE_EXTRA_CA_CERTS=/path/to/corporate-ca.pem

# Read replica (optional) — when DB_READ_HOST is set, GET-heavy queries can be
# routed to the replica. DB_READ_PORT falls back to DB_PORT / client default.
# DB_READ_HOST=
# DB_READ_PORT=

# Zero-downtime migrations (optional) — advisory lock prevents concurrent
# migration runs across instances during rolling deploys.
# MIGRATION_SAFE_MODE=true
# MIGRATION_LOCK_TIMEOUT_MS=60000
# Config restore point stored before pending boot migrations — time box in ms
# (default 30000; 0 = off). Boot never waits longer or fails because of it.
# PRE_MIGRATION_SNAPSHOT_MS=30000

# How long startup waits for the database and Redis before exiting for the
# orchestrator to restart it (after a host reboot they may come back later).
# BOOT_DEPS_WAIT_MS=120000

# ─── Session ─────────────────────────────────────────────────────────────────
# REQUIRED. At least 32 random characters; the API refuses to start without one, with a
# placeholder, or with a short/repetitive value. Generate one with:  openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL=86400
# Unset = Secure cookies when PUBLIC_URL or ADMIN_URL starts with https://, plain otherwise.
# Set true/false only to override (behind a TLS proxy also set TRUST_PROXY).
# COOKIE_SECURE=

# ─── Microsoft OAuth2 / OIDC ─────────────────────────────────────────────────
OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
OIDC_CLIENT_ID=your_azure_app_client_id
OIDC_CLIENT_SECRET=your_azure_app_client_secret
OIDC_REDIRECT_URI=http://localhost:3055/api/auth/callback

# ─── URLs ────────────────────────────────────────────────────────────────────
PUBLIC_URL=http://localhost:3055
ADMIN_URL=http://localhost:3055

# ─── Redis ───────────────────────────────────────────────────────────────────
# Overridden to redis://redis:6379 inside Docker Compose
REDIS_URL=redis://localhost:6379

# ─── AI Features (optional) ──────────────────────────────────────────────────
# Used by POST /api/ai/generate and /api/ai/summarize (admin only).
# Can also be configured via Settings > AI Features in the admin UI.
ANTHROPIC_API_KEY=

# ─── Mail (SMTP) — optional ──────────────────────────────────────────────────
MAIL_FROM=Nivaro <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
