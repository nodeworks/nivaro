# Keep the admin-project upload lean. Patterns are gitignore-style — anchor
# with a leading slash or a bare name matches at ANY depth (a bare `react/`
# once silently excluded packages/react and broke the build).
/api/
/examples/
/tests/
# The admin build runs scripts/precompress-dist.mjs (0.2.52): exclude the folder's contents,
# not the folder, or the file cannot be re-included.
/scripts/*
!/scripts/precompress-dist.mjs
*.test.ts
*.spec.ts
