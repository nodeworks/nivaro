{% layout 'base' %}
{% block content %}
{%- comment -%}
Generic notice — the fallback for any notifyUser email without a dedicated
template. Context: subject, message, first_name, category, record_card
(auto-built for business records), action_url / action_label, changes_url
(#3079: opens the inbox on this row's changes, read as the recipient).
{%- endcomment -%}
{%- if category and category != 'other' -%}{% render 'partials/eyebrow', text: category, tone: 'muted' %}{%- endif -%}
{% render 'partials/heading', text: subject %}
<p style="margin:0 0 20px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.55;color:#475569;">{% if first_name %}Hi {{ first_name | escape }}, {% endif %}{{ message | escape }}</p>
{% render 'partials/button', url: action_url, label: action_label %}
{%- if changes_url -%}
<p style="margin:-8px 0 20px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;color:#64748b;"><a href="{{ changes_url }}" style="color:#0f4c81;text-decoration:underline;">See what changed</a></p>
{%- endif -%}
{% render 'partials/record-card', card: record_card %}
{% endblock %}
