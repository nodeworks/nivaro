{% layout 'base' %}
{% block content %}
{%- comment -%}
Workflow / IR transition. Context = the `workflow-transition` trigger payload
(services/workflow-transitions.ts buildTransitionEventPayload): record_card,
approval_chain, brief, transition_label, from_state, to_state, comment,
actor_name, owners, record_url, friendly_id, latest_comment (newest people
comment on the record — nivaro_comments or a child notes table — rendered last).
{%- endcomment -%}
{%- comment -%}
An automatic move (source 'auto') is described in people's words: the
eyebrow says "Automatic update" (the route's label is a rule name an admin
gave it — "Auto-complete (Fusion accepted)" — not something to headline),
and `transition_text`, the transition's notify_text, says what happened.
{%- endcomment -%}
{%- assign automatic = false -%}
{%- unless actor_name -%}{%- if source == 'auto' -%}{%- assign automatic = true -%}{%- endif -%}{%- endunless -%}
<p style="margin:0 0 6px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;color:#0284a8;">{% if automatic %}Automatic update{% else %}{{ transition_label }}{% endif %}</p>
<h1 style="margin:0 0 6px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:21px;font-weight:700;line-height:1.3;color:#172940;">{{ friendly_id }} is now {{ to_state.label }}</h1>
{%- if actor_name -%}
<p style="margin:0 0 4px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.5;color:#1e293b;">{% if transition_text %}{{ transition_text }} &mdash; {% endif %}Triggered by <strong>{{ actor_name }}</strong>{% if actor_email %} <span style="color:#64748b;">&lt;{{ actor_email }}&gt;</span>{% endif %}{% if transitioned_at %} &middot; {{ transitioned_at | date: '%b %-d, %Y at %-I:%M %p' }}{% endif %}</p>
{%- elsif automatic -%}
<p style="margin:0 0 4px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.5;color:#1e293b;">Updated <strong>automatically</strong>{% if transitioned_at %} &middot; {{ transitioned_at | date: '%b %-d, %Y at %-I:%M %p' }}{% endif %} &mdash; no one had to do anything for this step.</p>
{%- else -%}
<p style="margin:0 0 4px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.5;color:#1e293b;">{% if transition_text %}{{ transition_text }} &mdash; {% endif %}Updated <strong>by the portal</strong>{% if source and source != 'manual' and source != 'harness' %} ({{ source | replace: '-', ' ' }}){% endif %}{% if transitioned_at %} &middot; {{ transitioned_at | date: '%b %-d, %Y at %-I:%M %p' }}{% endif %} &mdash; no person made this change.</p>
{%- endif -%}
<p style="margin:0 0 20px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.5;color:#475569;">
  {%- if from_state %}From <strong>{{ from_state.label }}</strong>{% if days_in_previous_state and days_in_previous_state >= 2 %} (after {{ days_in_previous_state | round }} days there){% elsif hours_in_previous_state and hours_in_previous_state >= 1 %} (after {{ hours_in_previous_state | round }}h there){% endif %} to{% else %}Started in{% endif %} <strong>{{ to_state.label }}</strong>.
  {%- if to_state.is_terminal %} Nothing further is needed.{% elsif owners and owners.size > 0 %} It is now waiting on {% for o in owners %}{{ o.first_name }} {{ o.last_name }}{% unless forloop.last %}, {% endunless %}{% endfor %}.{% endif -%}
</p>
{%- if comment_is_human -%}
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 22px;">
  <tr><td style="padding:12px 16px;background-color:#fffbeb;border:1px solid #fde68a;border-radius:8px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.5;color:#78350f;">&ldquo;{{ comment }}&rdquo;{% if actor_name %} <span style="color:#a16207;">&mdash; {{ actor_name }}</span>{% endif %}</td></tr>
</table>
{%- elsif automatic -%}
{%- comment -%}
The same callout a person's note gets, carrying what happened in plain
words (the transition's notify_text) — the rule name only as a footnote.
{%- endcomment -%}
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 22px;">
  <tr><td style="padding:12px 16px;background-color:#fffbeb;border:1px solid #fde68a;border-radius:8px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.5;color:#78350f;">{% if transition_text %}{{ transition_text }}{% else %}This happened automatically &mdash; the portal moved the record on its own.{% endif %}{% if transition_text %} <span style="color:#a16207;">&mdash; rule: {{ transition_label }}</span>{% endif %}</td></tr>
</table>
{%- endif -%}
{% render 'partials/button', url: record_url, label: 'Open record' %}
{% render 'partials/record-card', card: record_card %}
{% render 'partials/approval-chain', chain: approval_chain %}
{%- if brief and brief.field_changes and brief.field_changes.size > 0 -%}
{% assign changes_title = 'Changed while in ' | append: from_state.label %}
{% render 'partials/changed-fields', changes: brief.field_changes, title: changes_title %}
{%- if brief.changed_total > brief.field_changes.size -%}
<p style="margin:-14px 0 22px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;color:#94a3b8;">+ {{ brief.changed_total | minus: brief.field_changes.size }} more field(s) changed &middot; open the record for the full history.</p>
{%- endif -%}
{%- endif -%}
{%- if brief and brief.comments > 0 or brief.addendums.count > 0 -%}
<p style="margin:0 0 22px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;color:#64748b;">
  {%- if brief.comments > 0 %}{{ brief.comments }} note(s) added.{% endif -%}
  {%- if brief.addendums.count > 0 %} {{ brief.addendums.count }} addendum(s){% if brief.addendums.cost_impact != 0 %}, cost impact {{ brief.addendums.cost_impact | round: 2 }}{% endif %}.{% endif -%}
</p>
{%- endif -%}
{%- comment -%}
The newest thing a person wrote on the record (nivaro_comments or a child
note table), last so the reader leaves with the latest human context. Skipped
when it is the very comment quoted above.
{%- endcomment -%}
{%- if latest_comment and latest_comment.text != '' and latest_comment.text != comment -%}
<p style="margin:0 0 6px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;color:#7a90a6;">Latest comment</p>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 22px;">
  <tr><td style="padding:12px 16px;background-color:#f4f7fa;border:1px solid #dde3ea;border-radius:8px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.55;color:#334155;white-space:pre-wrap;">{{ latest_comment.text }}<br><span style="display:inline-block;margin-top:8px;font-size:12px;color:#7a90a6;">&mdash; {% if latest_comment.author_name %}{{ latest_comment.author_name }}{% else %}Unknown author{% endif %}{% if latest_comment.at %} &middot; {{ latest_comment.at | date: '%b %-d, %Y at %-I:%M %p' }}{% endif %}</span></td></tr>
</table>
{%- endif -%}
{% endblock %}
