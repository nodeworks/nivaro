{%- comment -%}
Record card: title + link + the collection's item-header fields.
Usage: {% render 'partials/record-card', card: record_card, eyebrow: 'Workflow' %}
{%- endcomment -%}
{%- if card -%}
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 22px;border:1px solid #dde3ea;border-radius:8px;border-collapse:separate;overflow:hidden;">
  <tr>
    <td style="padding:16px 18px 12px;background-color:#f4f7fa;border-bottom:1px solid #dde3ea;">
      <p style="margin:0 0 4px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;color:#7a90a6;">{{ eyebrow | default: card.collection_label }}</p>
      <p style="margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;font-weight:700;line-height:1.3;color:#172940;"><a href="{{ card.url }}" style="color:#172940;text-decoration:none;">{{ card.title }}</a></p>
    </td>
  </tr>
  {%- if card.fields and card.fields.size > 0 -%}
  <tr>
    <td style="padding:6px 18px 10px;background-color:#ffffff;">
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
        {%- for f in card.fields -%}
        <tr>
          <td width="38%" style="padding:6px 0;vertical-align:top;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;color:#7a90a6;">{{ f.label }}</td>
          <td style="padding:6px 0;vertical-align:top;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;color:#1e293b;{% if f.value == '—' %}color:#a3aebd;{% endif %}">{{ f.value }}</td>
        </tr>
        {%- endfor -%}
      </table>
    </td>
  </tr>
  {%- endif -%}
</table>
{%- endif -%}
