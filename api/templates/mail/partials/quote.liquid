{%- if text and text != '' -%}
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 22px;">
  <tr><td style="padding:12px 16px;background-color:#f4f7fa;border:1px solid #dde3ea;border-radius:8px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.5;color:#334155;">{{ text }}{% if by %} <span style="color:#7a90a6;">&mdash; {{ by }}</span>{% endif %}</td></tr>
</table>
{%- endif -%}
