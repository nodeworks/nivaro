{% layout 'base' %}
{% block content %}
<p style="margin:0 0 6px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;color:#b91c1c;">Canceled</p>
<h1 style="margin:0 0 6px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:21px;font-weight:700;line-height:1.3;color:#172940;">{{ friendly_id }} was canceled</h1>
{%- if actor_name -%}
<p style="margin:0 0 4px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.5;color:#1e293b;">Canceled by <strong>{{ actor_name }}</strong>{% if actor_email %} <span style="color:#64748b;">&lt;{{ actor_email }}&gt;</span>{% endif %}{% if transitioned_at %} &middot; {{ transitioned_at | date: '%b %-d, %Y at %-I:%M %p' }}{% endif %}</p>
{%- else -%}
<p style="margin:0 0 4px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.5;color:#1e293b;"><strong>Canceled automatically</strong> by the system{% if transitioned_at %} on {{ transitioned_at | date: '%b %-d, %Y at %-I:%M %p' }}{% endif %}.</p>
{%- endif -%}
<p style="margin:0 0 20px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.5;color:#475569;">{% if from_state %}It was in <strong>{{ from_state.label }}</strong>. {% endif %}Nothing further will happen on this record unless it is uncanceled.</p>
{%- if comment_is_human -%}
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 22px;">
  <tr><td style="padding:12px 16px;background-color:#fef2f2;border:1px solid #fecaca;border-radius:8px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.5;color:#7f1d1d;">&ldquo;{{ comment }}&rdquo;</td></tr>
</table>
{%- endif -%}
{% render 'partials/button', url: record_url, label: 'Open record' %}
{% render 'partials/record-card', card: record_card %}
{% render 'partials/approval-chain', chain: approval_chain %}
{%- comment -%}
The newest thing a person wrote on the record (nivaro_comments or a child
note table), last so the reader leaves with the latest human context. Skipped
when it is the very comment quoted above.
{%- endcomment -%}
{%- if latest_comment and latest_comment.text != '' and latest_comment.text != comment -%}
<p style="margin:0 0 6px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;color:#7a90a6;">Latest comment</p>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 22px;">
  <tr><td style="padding:12px 16px;background-color:#f4f7fa;border:1px solid #dde3ea;border-radius:8px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13.5px;line-height:1.55;color:#334155;white-space:pre-wrap;">{{ latest_comment.text }}<br><span style="display:inline-block;margin-top:8px;font-size:12px;color:#7a90a6;">&mdash; {% if latest_comment.author_name %}{{ latest_comment.author_name }}{% else %}Unknown author{% endif %}{% if latest_comment.at %} &middot; {{ latest_comment.at | date: '%b %-d, %Y at %-I:%M %p' }}{% endif %}</span></td></tr>
</table>
{%- endif -%}
{% endblock %}
