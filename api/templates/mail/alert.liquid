{% layout 'base' %}
{% block content %}
{%- if kind == 'report' -%}{% render 'partials/eyebrow', text: 'Report alert', tone: 'warn' %}{%- else -%}{% render 'partials/eyebrow', text: 'Alert', tone: 'warn' %}{%- endif -%}
{% render 'partials/heading', text: rule_name %}
{%- if kind == 'report' -%}
{% assign _text29107 = '“' | append: widget_title | append: '” crossed your threshold.' %}{% render 'partials/lead', text: _text29107 %}
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 22px;border:1px solid #dde3ea;border-radius:8px;border-collapse:separate;overflow:hidden;">
  {%- for c in conditions -%}
  <tr>
    <td style="padding:9px 14px;border-bottom:1px solid #eef2f6;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;color:#334155;">{{ c.label }}</td>
    <td align="right" style="padding:9px 14px;border-bottom:1px solid #eef2f6;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;color:#b45309;white-space:nowrap;">now {{ c.now }}</td>
  </tr>
  {%- endfor -%}
</table>
{% render 'partials/button', url: report_url, label: 'Open the report' %}
{%- else -%}
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 22px;">
  <tr>
    <td style="padding:14px 18px;background-color:#fffbeb;border:1px solid #fde68a;border-radius:8px;">
      <p style="margin:0 0 2px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10.5px;font-weight:700;letter-spacing:0.6px;text-transform:uppercase;color:#a16207;">{{ metric_name }}</p>
      <p style="margin:0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.15;color:#172940;">{{ metric_value }}</p>
      {%- if operator and threshold_value != '' -%}<p style="margin:4px 0 0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;color:#78350f;">Threshold: {{ operator }} {{ threshold_value }}</p>{%- endif -%}
    </td>
  </tr>
</table>
{%- if detail -%}{% render 'partials/lead', text: detail %}{%- endif -%}
{% render 'partials/button', url: record_url, label: 'Open record', secondary_url: manage_url, secondary_label: 'Manage alerts' %}
{% render 'partials/record-card', card: record_card %}
{%- endif -%}
{% endblock %}
