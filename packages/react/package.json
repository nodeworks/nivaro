{
  "name": "@nivaro/react",
  "version": "0.1.134",
  "description": "React hooks and components for Nivaro CMS forms",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./styles.css": "./styles.css",
    "./full.css": "./dist/full.css"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "tailwind-preset.cjs",
    "styles.css",
    "README.md"
  ],
  "keywords": [
    "cms",
    "headless-cms",
    "nivaro",
    "react",
    "forms",
    "hooks",
    "typescript"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && pnpm build:css",
    "build:watch": "pnpm build:css && VITE_WATCH=1 vite build --watch",
    "build:css": "tailwindcss -c tailwind-build.config.cjs -i full.src.css -o dist/_tw.css --minify && cat styles.css dist/_tw.css > dist/full.css && rm dist/_tw.css",
    "dev": "tsc --watch"
  },
  "peerDependencies": {
    "@nivaro/sdk": ">=0.1.0",
    "@tanstack/react-query": "^5",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "sonner": "^1",
    "rrweb": "^2.0.0-alpha.4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/extension-underline": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.0.0",
    "lucide-react": "^0.460.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.9",
    "tailwindcss": "^3.4.17",
    "@nivaro/sdk": "workspace:*",
    "@nivaro/shared": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.0.2",
    "rrweb": "^2.0.0-alpha.18"
  },
  "peerDependenciesMeta": {
    "rrweb": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodeworks/nivaro.git",
    "directory": "packages/react"
  }
}
