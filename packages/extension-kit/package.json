{
  "name": "@nivaro/extension-kit",
  "version": "0.1.9",
  "description": "The contract a Nivaro extension is written against: the extension context, every registration type, and the small pure helpers extensions used to hand-copy from the API.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "nivaro",
    "extension",
    "types"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodeworks/nivaro.git",
    "directory": "packages/extension-kit"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "fastify": "^5",
    "knex": "^3"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "knex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "fastify": "^5.3.3",
    "knex": "^3.1.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.0"
  }
}
