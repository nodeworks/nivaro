{
  "name": "@nivaro/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Nivaro CMS — lets Claude Code, Claude Desktop and Cursor read and write an instance through the typed SDK under an API key.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "nivaro-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cms",
    "headless-cms",
    "nivaro",
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "typescript"
  ],
  "homepage": "https://nivaro.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodeworks/nivaro.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/nodeworks/nivaro/issues",
    "email": "support@nivaro.dev"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --out-dir dist",
    "dev": "tsup src/index.ts src/cli.ts --format esm --dts --out-dir dist --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nivaro/sdk": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.0"
  }
}
