{
  "mirror": "git@github.com:your-org/your-public-mirror.git",
  "workflows_repo": "your-org/your-public-mirror",
  "image": "your-namespace/nivaro",
  "frontends": [
    {
      "name": "portal",
      "path": "~/code/portal",
      "branch": "main",
      "build": "build"
    }
  ],
  "deployments": [
    {
      "name": "staging",
      "path": "~/code/staging-deploy",
      "branch": "main",
      "prepare": [
        "bash scripts/sync-extension.sh",
        "pnpm build"
      ],
      "commit_paths": [
        "src/extensions"
      ],
      "version_file": ".docker/staging-version"
    }
  ],
  "verify": [
    {
      "name": "staging api",
      "url": "https://staging.example.com/api/version",
      "field": "version"
    },
    {
      "name": "staging frontend",
      "url": "https://staging.example.com/version.json",
      "field": "version",
      "expect": "frontend:portal"
    }
  ],
  "production": {
    "name": "production",
    "enabled": false,
    "path": "~/code/staging-deploy",
    "source_branch": "main",
    "branch": "production",
    "pin_file": ".docker/nivaro-version",
    "route_conf": ".docker/production.conf",
    "gitlab": {
      "api": "https://gitlab.example.com/api/v4",
      "project": "group/deploy"
    },
    "verify": [
      {
        "name": "production api",
        "url": "https://api.example.com/api/version",
        "field": "version"
      }
    ],
    "frontend": {
      "name": "portal",
      "path": "~/code/portal",
      "source_branch": "main",
      "branch": "production",
      "gitlab_project": "group/portal",
      "staging_url": "https://staging.example.com/version.json",
      "verify": [
        {
          "name": "production portal",
          "url": "https://app.example.com/version.json",
          "field": "version"
        }
      ]
    }
  }
}
