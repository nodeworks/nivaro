# Realtime CI — every host port and knob in one place. rtci.sh passes this to compose
# (--env-file) and tests/realtime/config.mjs reads the same file, so a port moves here only.
# Host ports bind 127.0.0.1 and stay off 3055/3056/3057/1433/6379/6679/8474 (dev) and
# 13055/11433/16379/18474 (chaos-ci).
RTCI_HTTP_PORT=24080
RTCI_HTTP_V2_PORT=24082
RTCI_DASH_PORT=24088
RTCI_TOXI_PORT=24474
RTCI_MSSQL_PORT=24433
RTCI_REDIS_PORT=24379
RTCI_WEB1_PORT=24101
RTCI_WEB2_PORT=24102
RTCI_WEB3_PORT=24103
RTCI_RT1_PORT=24111
RTCI_RT2_PORT=24112
RTCI_WORKER_PORT=24121
RTCI_LOG_LEVEL=info
RTCI_TRAEFIK_LOG=WARN
RTCI_WORKER_CRONS=on
# Static token of the bootstrap administrator (rtci.sh inserts it by SQL into the stack's own
# empty database; everything else is seeded through the API).
RTCI_ADMIN_TOKEN=rtci-bootstrap-admin-token-0001
RTCI_PG_PORT=24432
RTCI_CLOUD1_PORT=24131
RTCI_CLOUD2_PORT=24132
