# Variable names only; real values live on the staging host. `set -a; . ./.env; set +a` before `docker stack deploy`.
MAILPIT_VERSION=
MAILPIT_MAX_MESSAGES=5000
# Swarm secret names (Swarm secrets are immutable: a rotation uses a new name, e.g. mailpit_relay_v2)
MAILPIT_UI_AUTH_SECRET=
MAILPIT_RELAY_SECRET=
# Recipient regexes
MAILPIT_ALLOWED_RECIPIENTS=
MAILPIT_BLOCKED_RECIPIENTS=
# Optional: one narrow test mailbox that is always relayed (leave empty to catch everything)
MAILPIT_RELAY_MATCHING=

# Staging API settings (in the API's own env, not read by the stack file):
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_SECURE=false
