# Variable names only; real values live on the staging manager in .docker/mailpit/.env.
# `set -a; . .docker/mailpit/.env; set +a` before `docker stack deploy ... efp_mail`.
MAILPIT_VERSION=
MAILPIT_MAX_MESSAGES=5000
# The staging API hostname; the inbox is https://<host>/mailpit/
MAILPIT_UI_HOST=efp-staging-api.cable.example.com
# Swarm secret names (Swarm secrets are immutable: a rotation uses a new name, e.g. mailpit_relay_v2)
MAILPIT_UI_AUTH_SECRET=
# Only read by stack.relay.yml (omit that file to run catch-only)
MAILPIT_RELAY_SECRET=
# allowed-recipients and blocked-recipients are NOT variables: they live in the relay YAML
# Swarm secret (see relay.example.yml).

# Staging API settings (in efp-nivaro's ../.env, read by the efp stack, not by this kit):
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_SECURE=false
#   NIVARO_SETTINGS_OVERRIDES={"smtp_host":"mailpit","smtp_port":1025,"smtp_secure":false,"smtp_user":null,"smtp_pass":null,"mail_test_mode":false}
#   (and no MAIL_TEST_MODE line; see docs/STAGING-MAIL.md "Test mode")
