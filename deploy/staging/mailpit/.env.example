# Variable names only; real values (and secrets) live on the staging host.
MAILPIT_VERSION=
MAILPIT_MAX_MESSAGES=5000
# Private/VPN address for the web UI, never 0.0.0.0
MAILPIT_UI_BIND=127.0.0.1
# Host secrets paths
MAILPIT_UI_AUTH_FILE=
MAILPIT_RELAY_CONFIG_FILE=
MAILPIT_RELAY_ENV_FILE=
# Recipient regexes
MAILPIT_ALLOWED_RECIPIENTS=
MAILPIT_BLOCKED_RECIPIENTS=
# Optional: one narrow test mailbox that is always relayed (leave empty to catch everything)
MAILPIT_RELAY_MATCHING=

# Staging API settings (in the API's own env, not read by this compose):
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_SECURE=false
