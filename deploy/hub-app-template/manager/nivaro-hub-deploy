#!/bin/sh
# nivaro-hub-deploy — the ONLY thing a Nivaro Hub deploy key may run on this swarm manager.
#
# Installed once by the operator (README.md, "Manager setup") as /usr/local/bin/nivaro-hub-deploy
# and bound to the deploy key in ~deploy/.ssh/authorized_keys:
#
#   command="/usr/local/bin/nivaro-hub-deploy <key>",no-pty,no-port-forwarding,no-agent-forwarding,no-X11-forwarding,restrict ssh-ed25519 AAAA…
#
# Whatever the CI job asks for arrives in SSH_ORIGINAL_COMMAND and is only ever one of:
#
#   stack-owner <stack>                   print "<app>/<env>" of the stack's services (or nothing)
#   secret-create <stack>_<name>_<sha8>   create that swarm secret from stdin; the name must be
#                                         one of the five Hub secrets and <sha8> the first 8 hex
#                                         of sha256(value) — a name never changes its value
#   deploy <stack>                        read KEY=value settings from stdin, check every one,
#                                         and deploy the stack file installed HERE (never one
#                                         sent by the job), then wait for /api/version
#
# <stack> matches ^[a-z][a-z0-9-]{1,39}$ and starts with a prefix=… of this key's configuration
# ($ROOT/keys/<key>.conf). Hostnames must end in a host=… of it, the image must be its image=…
# by digest, the proxy network its network=…. Anything else is refused before docker runs. The
# key gets no shell, no pty and no forwarding, so the Docker socket is never reachable from CI.
set -eu
set -f
umask 077
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
ROOT=/etc/nivaro-hub-deploy
STACK_FILE="$ROOT/docker-stack.yml"

refuse() {
  printf 'nivaro-hub-deploy: %s\n' "$*" >&2
  exit 2
}

# ── this key's configuration ─────────────────────────────────────────────────
[ "$#" -le 1 ] || refuse "one argument at most (the key name) in authorized_keys"
KEY=${1:-default}
case "$KEY" in '' | *[!a-z0-9_-]*) refuse "bad key name in authorized_keys" ;; esac
CONF="$ROOT/keys/$KEY.conf"
[ -f "$CONF" ] || refuse "no configuration for key $KEY"
[ -f "$STACK_FILE" ] || refuse "no stack file at $STACK_FILE"

PREFIXES=''
HOSTS=''
NETWORK=proxy
IMAGE=nodeworks/nivaro
ENTRYPOINT_HTTPS=websecure
ENTRYPOINT_HTTP=web
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in '' | '#'*) continue ;; esac
  k=${line%%=*}
  v=${line#*=}
  [ "$k" != "$line" ] || refuse "bad line in $CONF"
  case "$k" in
    prefix)
      case "$v" in [a-z]*) ;; *) refuse "bad prefix in $CONF" ;; esac
      case "$v" in *[!a-z0-9-]*) refuse "bad prefix in $CONF" ;; esac
      PREFIXES="$PREFIXES $v"
      ;;
    host)
      case "$v" in '' | [-.]* | *[-.] | *..* | *.-* | *-.* | *[!a-z0-9.-]*) refuse "bad host in $CONF" ;; esac
      HOSTS="$HOSTS $v"
      ;;
    network)
      case "$v" in '' | [!A-Za-z0-9]* | *[!A-Za-z0-9_.-]*) refuse "bad network in $CONF" ;; esac
      NETWORK=$v
      ;;
    image)
      case "$v" in '' | [!a-z0-9]* | *[!a-z0-9./_-]*) refuse "bad image in $CONF" ;; esac
      IMAGE=$v
      ;;
    entrypoint_https | entrypoint_http)
      case "$v" in '' | *[!A-Za-z0-9_-]*) refuse "bad entry point in $CONF" ;; esac
      if [ "$k" = entrypoint_https ]; then ENTRYPOINT_HTTPS=$v; else ENTRYPOINT_HTTP=$v; fi
      ;;
    *) refuse "unknown setting $k in $CONF" ;;
  esac
done <"$CONF"
[ -n "$PREFIXES" ] || refuse "$CONF has no prefix= line"
[ -n "$HOSTS" ] || refuse "$CONF has no host= line"

# ── the command ──────────────────────────────────────────────────────────────
cmd=${SSH_ORIGINAL_COMMAND:-}
[ -n "$cmd" ] || refuse "no command"
[ "${#cmd}" -le 200 ] || refuse "command too long"
rest=$(printf '%s' "$cmd" | tr -d 'a-z0-9_ -')
[ -z "$rest" ] || refuse "command not allowed"
old_ifs=$IFS
IFS=' '
# shellcheck disable=SC2086 # split on spaces on purpose; globbing is off and only [a-z0-9_ -] remain
set -- $cmd
IFS=$old_ifs
[ "$#" -eq 2 ] || refuse "command not allowed"
VERB=$1
ARG=$2

check_stack() {
  case "$1" in [a-z]*) ;; *) refuse "stack name not allowed" ;; esac
  case "$1" in *[!a-z0-9-]*) refuse "stack name not allowed" ;; esac
  [ "${#1}" -ge 2 ] && [ "${#1}" -le 40 ] || refuse "stack name not allowed"
  for p in $PREFIXES; do
    case "$1" in "$p"*) return 0 ;; esac
  done
  refuse "stack $1 is outside this key's prefixes"
}

# "<app>/<env>" of the stack's services, "" when it has none; refuses a mix.
stack_owner() {
  names=$(docker service ls --filter "label=com.docker.stack.namespace=$1" --format '{{.Name}}') ||
    refuse "cannot list services"
  found=''
  for svc in $names; do
    o=$(docker service inspect --format '{{index .Spec.Labels "nivaro.hub.app"}}/{{index .Spec.Labels "nivaro.hub.env"}}' "$svc") ||
      refuse "cannot read service labels"
    if [ -z "$found" ]; then found=$o; elif [ "$found" != "$o" ]; then refuse "stack $1 has services of several owners"; fi
  done
  printf '%s' "$found"
}

SECRET_SHORTS="db_url hub_token session_secret encryption_key oidc_secret"

case "$VERB" in
  stack-owner)
    check_stack "$ARG"
    owner=$(stack_owner "$ARG")
    printf '%s\n' "$owner"
    ;;

  secret-create)
    stack=${ARG%%_*}
    tail=${ARG#*_}
    short=${tail%_*}
    sha8=${tail##*_}
    [ "$ARG" = "${stack}_${short}_${sha8}" ] || refuse "secret name not allowed"
    check_stack "$stack"
    case " $SECRET_SHORTS " in *" $short "*) ;; *) refuse "secret name not allowed" ;; esac
    case "$sha8" in *[!0-9a-f]*) refuse "secret name not allowed" ;; esac
    [ "${#sha8}" -eq 8 ] || refuse "secret name not allowed"
    value=$(head -c 65537)
    [ -n "$value" ] || refuse "empty secret"
    [ "${#value}" -le 65536 ] || refuse "secret too long"
    have=$(printf '%s' "$value" | sha256sum | cut -c1-8)
    [ "$have" = "$sha8" ] || refuse "the secret name does not match its value"
    if docker secret inspect "$ARG" >/dev/null 2>&1; then
      value=
      echo exists
    else
      printf '%s' "$value" | docker secret create --label "nivaro.hub.stack=$stack" --label "nivaro.hub.key=$KEY" "$ARG" - >/dev/null ||
        refuse "docker refused the secret"
      value=
      echo created
    fi
    ;;

  deploy)
    check_stack "$ARG"
    ALLOWED="APP_KEY ENV_KEY STACK_NAME APP_HOSTS PUBLIC_URL ADMIN_URL HUB_URL NIVARO_ENVIRONMENT DB_CLIENT OIDC_ISSUER OIDC_CLIENT_ID OIDC_REDIRECT_URI PROXY_NETWORK TRUST_PROXY NIVARO_IMAGE_REF NIVARO_VERSION SECRET_DB_URL SECRET_HUB_TOKEN SECRET_SESSION_SECRET SECRET_ENCRYPTION_KEY SECRET_OIDC_SECRET WAIT_TRIES"
    CR=$(printf '\r')
    seen=' '
    count=0
    while IFS= read -r line || [ -n "$line" ]; do
      count=$((count + 1))
      [ "$count" -le 64 ] || refuse "too many settings"
      [ "${#line}" -le 2000 ] || refuse "setting too long"
      case "$line" in '' | '#'*) continue ;; esac
      k=${line%%=*}
      v=${line#*=}
      [ "$k" != "$line" ] || refuse "a setting without '='"
      case "$k" in '' | *[!A-Z0-9_]*) refuse "bad setting name" ;; esac
      case " $ALLOWED " in *" $k "*) ;; *) refuse "$k is not a deploy setting" ;; esac
      case "$seen" in *" $k "*) refuse "$k twice" ;; esac
      seen="$seen$k "
      case "$v" in *"$CR"*) refuse "$k holds a carriage return" ;; esac
      [ -n "$v" ] || refuse "$k is empty"
      export "$k=$v"
    done
    for k in $ALLOWED; do
      [ "$k" = WAIT_TRIES ] && continue
      case "$seen" in *" $k "*) ;; *) refuse "missing $k" ;; esac
    done

    [ "$STACK_NAME" = "$ARG" ] || refuse "STACK_NAME is not the stack being deployed"
    for k in "$APP_KEY" "$ENV_KEY"; do
      case "$k" in [a-z]*) ;; *) refuse "APP_KEY / ENV_KEY not allowed" ;; esac
      case "$k" in *[!a-z0-9-]* | *-- | *--* | *-) refuse "APP_KEY / ENV_KEY not allowed" ;; esac
    done
    case "$DB_CLIENT" in mssql | pg | mysql2 | mariadb) ;; *) refuse "DB_CLIENT not allowed" ;; esac
    case "$NIVARO_ENVIRONMENT" in production | staging | development | test | other) ;; *) refuse "NIVARO_ENVIRONMENT not allowed" ;; esac
    case "$TRUST_PROXY" in '' | *[!0-9]*) refuse "TRUST_PROXY must be a hop count" ;; esac
    [ "$PROXY_NETWORK" = "$NETWORK" ] || refuse "PROXY_NETWORK is not this manager's proxy network"
    case "$NIVARO_VERSION" in '' | latest | *[!0-9A-Za-z.+-]*) refuse "NIVARO_VERSION not allowed" ;; esac
    digest=${NIVARO_IMAGE_REF#"$IMAGE"@sha256:}
    [ "$digest" != "$NIVARO_IMAGE_REF" ] || refuse "the image must be $IMAGE@sha256:<digest>"
    case "$digest" in *[!0-9a-f]*) refuse "bad image digest" ;; esac
    [ "${#digest}" -eq 64 ] || refuse "bad image digest"
    case "$PUBLIC_URL" in
      https://*) TRAEFIK_TLS=true TRAEFIK_ENTRYPOINT=$ENTRYPOINT_HTTPS ;;
      http://*) TRAEFIK_TLS=false TRAEFIK_ENTRYPOINT=$ENTRYPOINT_HTTP ;;
      *) refuse "PUBLIC_URL must be http(s)" ;;
    esac
    WAIT_TRIES=${WAIT_TRIES:-40}
    case "$WAIT_TRIES" in '' | *[!0-9]*) refuse "WAIT_TRIES must be a number" ;; esac
    [ "$WAIT_TRIES" -ge 1 ] && [ "$WAIT_TRIES" -le 80 ] || refuse "WAIT_TRIES must be 1-80"

    TRAEFIK_RULE=''
    IFS=,
    for h in $APP_HOSTS; do
      case "$h" in
        '' | [-.]* | *[-.] | *..* | *.-* | *-.* | *[!a-z0-9.-]*) refuse "APP_HOSTS: '$h' is not a hostname" ;;
      esac
      ok=''
      for allowed in $(printf '%s' "$HOSTS" | tr ' ' ','); do
        [ -n "$allowed" ] || continue
        case "$h" in "$allowed" | *".$allowed") ok=1 ;; esac
      done
      [ -n "$ok" ] || refuse "APP_HOSTS: $h is outside this key's hosts"
      TRAEFIK_RULE="${TRAEFIK_RULE:+$TRAEFIK_RULE || }Host(\`$h\`)"
    done
    IFS=$old_ifs
    [ -n "$TRAEFIK_RULE" ] || refuse "APP_HOSTS is empty"

    for pair in DB_URL:db_url HUB_TOKEN:hub_token SESSION_SECRET:session_secret ENCRYPTION_KEY:encryption_key OIDC_SECRET:oidc_secret; do
      var=SECRET_${pair%%:*}
      short=${pair#*:}
      name=$(printenv "$var")
      sha8=${name#"${ARG}_${short}_"}
      [ "$sha8" != "$name" ] || refuse "$var is not a secret of this stack"
      case "$sha8" in *[!0-9a-f]*) refuse "$var is not a secret of this stack" ;; esac
      [ "${#sha8}" -eq 8 ] || refuse "$var is not a secret of this stack"
      docker secret inspect "$name" >/dev/null 2>&1 || refuse "$var names a secret that does not exist"
    done

    owner=$(stack_owner "$ARG")
    case "$owner" in '' | "$APP_KEY/$ENV_KEY") ;; *) refuse "stack $ARG belongs to $owner" ;; esac
    docker network inspect "$NETWORK" >/dev/null 2>&1 || refuse "the proxy network $NETWORK does not exist"

    export TRAEFIK_RULE TRAEFIK_TLS TRAEFIK_ENTRYPOINT
    docker stack deploy --detach=false --resolve-image always -c "$STACK_FILE" "$ARG"

    tries=0
    while :; do
      out=$(docker run --rm --network "${ARG}_internal" --read-only --cap-drop ALL \
        --security-opt no-new-privileges --entrypoint wget "$NIVARO_IMAGE_REF" \
        -q -T 5 -O - http://web:3055/api/version 2>/dev/null || true)
      case "$out" in *"\"version\":\"$NIVARO_VERSION\""*) break ;; esac
      tries=$((tries + 1))
      [ "$tries" -lt "$WAIT_TRIES" ] || refuse "web did not answer /api/version with $NIVARO_VERSION"
      sleep 15
    done
    echo "web answers $NIVARO_VERSION"
    ;;

  *) refuse "command not allowed" ;;
esac
