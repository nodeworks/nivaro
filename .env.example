# ─── API ────────────────────────────────────────────────────────────────────
PORT=3055
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_URL=http://localhost:3055

# ─── Database (MSSQL) ────────────────────────────────────────────────────────
DB_HOST=your-db-host.example.com
DB_PORT=1433
DB_DATABASE=your_database
DB_USER=sa
DB_PASSWORD=your_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Session ─────────────────────────────────────────────────────────────────
# Must be at least 32 characters
SESSION_SECRET=change_this_to_a_long_random_string_minimum_32_chars
SESSION_TTL=86400
# Set to true only when serving over HTTPS (false for local dev and plain-HTTP Docker)
COOKIE_SECURE=false

# ─── Microsoft OAuth2 / OIDC ─────────────────────────────────────────────────
OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
OIDC_CLIENT_ID=your_azure_app_client_id
OIDC_CLIENT_SECRET=your_azure_app_client_secret
OIDC_REDIRECT_URI=http://localhost:3055/api/auth/callback

# ─── Admin UI ────────────────────────────────────────────────────────────────
# Where to redirect after login
ADMIN_URL=http://localhost:3056

# ─── Inngest ─────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local

# ─── Mail (SMTP) ─────────────────────────────────────────────────────────────
MAIL_FROM=Nivaro <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ─── File Storage ────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads

# ─── Performance & diagnostics (all optional) ────────────────────────────────
# Configuration reads are cached underneath the query layer (SQL Server only).
# METADATA_QUERY_CACHE=off
# METADATA_QUERY_CACHE_TTL_MS=30000
# Other processes clear their caches when configuration is written (poll, ms)
# CACHE_EPOCH=off
# CACHE_EPOCH_POLL_MS=5000
# Statement shapes kept per slow-request trace
# TRACE_TOP_SQL=8
# Scheduled jobs fire on the clock only in production-mode processes by default
# (a development process usually shares its database with a deployed instance).
# on = tick here too (your own database); off = never tick (a throwaway boot).
# CRON_TICKS=
# How long an answer is kept for a repeated Idempotency-Key (seconds)
# IDEMPOTENCY_TTL_SECONDS=86400
# The same transition on the same record is refused within this many seconds (0 = off)
# TRANSITION_GUARD_SECONDS=10
